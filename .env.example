# AGT Event Calendar secrets and bootstrap values (.env)
# Copy to .env. Never commit .env; it is never included in backups.

# Temporary setup password, used ONLY on first run to create the single admin
# account in the dashboard (/admin). It does not become the admin password.
#
# Once the admin account exists this value is ignored permanently. You can and
# should then remove it from .env and restart the container
# (docker compose up -d). While it is still set, the server logs a warning at
# every startup and the dashboard shows a reminder.
AGT_SETUP_PASSWORD=
