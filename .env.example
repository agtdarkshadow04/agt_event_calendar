# AGT Event Calendar secrets and bootstrap values (.env)
# Copy to .env (Docker) or /etc/agt-event-calendar/.env (local installation).
# Never commit .env; it is never included in backups.

# Temporary setup password, used ONLY on first run to create the single admin
# account in the dashboard (/admin). It does not become the admin password.
#
# Once the admin account exists this value is ignored permanently. You can and
# should then REMOVE this line and restart:
#   Docker:              docker compose up -d
#   Local installation:  sudo systemctl restart agt-event-calendar
# While it is still set, the server logs a warning at every startup and the
# dashboard shows a reminder.
AGT_SETUP_PASSWORD=
