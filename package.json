{
  "name": "agt-event-calendar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc -b --pretty false",
    "check": "npm run lint && npm test && npm run build",
    "test": "esbuild src/lib/*.test.ts --bundle --platform=node --format=esm --outdir=.test-build --out-extension:.js=.mjs && node --test .test-build/*.test.mjs"
  },
  "dependencies": {
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.16",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.25.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
